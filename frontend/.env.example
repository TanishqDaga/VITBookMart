# ---------------------------------------------------------------------------
# VITBookMart frontend configuration
# Copy this file to `.env` and fill in the values.
# Never commit a real .env — and never put the Google client SECRET here.
# ---------------------------------------------------------------------------

# Base URL the frontend uses for API calls.
# Leave EMPTY in development so requests go to "/api" on the Vite dev server,
# which proxies to the backend (works around the backend having no CORS config).
# In production set this to the deployed backend origin, e.g. https://api.vitbookmart.com
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /api requests during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:8080

# Google OAuth 2.0 Web Client ID (public — safe in the frontend).
# The client SECRET stays on the backend only.
VITE_GOOGLE_CLIENT_ID=

# Redirect URI registered in Google Cloud Console.
# MUST be byte-for-byte identical to the backend's GOOGLE_REDIRECT_URI env var,
# because the backend replays it when exchanging the authorization code.
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Optional: pre-filters the Google account chooser to one hosted domain.
# This is a UX hint only, never a security control. Leave blank to allow any account.
VITE_GOOGLE_HOSTED_DOMAIN=

# The backend stores LocalDateTime (no timezone). Set to "true" when the backend
# server runs in UTC so relative timestamps ("2 hours ago") are computed correctly.
VITE_BACKEND_TIME_IS_UTC=true

# Where the footer "Contribute" call to action points. Placeholder by default.
VITE_CONTRIBUTE_URL=
VITE_CONTACT_EMAIL=
