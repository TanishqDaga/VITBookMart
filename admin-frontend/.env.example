# ---------------------------------------------------------------------------
# VITBookMart ADMIN portal configuration
# Copy to `.env`. This portal is for staff only — do not deploy it publicly.
# ---------------------------------------------------------------------------

# Leave EMPTY in development: requests go to /api and the Vite proxy forwards
# them, which works around the backend having no CORS configuration.
VITE_API_BASE_URL=

# Where the dev proxy forwards /api during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:8080

# Backend stores LocalDateTime with no timezone. "true" if the server runs in UTC.
VITE_BACKEND_TIME_IS_UTC=true
